{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    // Same as the Vite alias: check against the plugin source, not its dist.
    "paths": {
      "@navaramap/maplibre-style": ["../src/index.ts"]
    }
  },
  "include": ["lib", "render", "*.ts"],
  "exclude": ["node_modules", "test-results"]
}
